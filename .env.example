# 이 파일을 복사해서 .env 로 만들어 사용한다: cp .env.example .env
# .env 는 .gitignore 되어 커밋되지 않는다. 비밀 값은 절대 커밋하지 말 것.

# 로컬 LLM (llama.cpp gguf)
LOCAL_LLM_MODEL_PATH=/home/chatbot/voicebot/models/qwen2.5-0.5b-instruct-q4_k_m.gguf

# 로컬 STT (SenseVoiceSmall ONNX)
SENSEVOICE_DIR=/home/chatbot/voicebot/models/sensevoice_ko
STT_LANGUAGE=ko
# int8 양자화 모델(model_quant.onnx)을 쓰려면 true
SENSEVOICE_QUANTIZE=false

# TTS (edge-tts)
EDGE_TTS_VOICE=ko-KR-SunHiNeural

# 호출 이름(웨이크워드)
BOT_NAME=제리
REQUIRE_WAKE_NAME=true

# 오디오 녹음
RECORD_SECONDS=5
# INPUT_DEVICE를 비워두면 시스템 기본 입력(ReSpeaker)을 사용한다.
INPUT_DEVICE=
SAMPLE_RATE=16000
CHANNELS=1

# 로컬 LLM 파라미터 (Pi 4B 4GB 기준)
N_CTX=512
N_THREADS=4
N_THREADS_BATCH=4
N_BATCH=128
MAX_HISTORY_MESSAGES=4
MAX_TOKENS=60
TEMPERATURE=0.4
TOP_P=0.9
REPEAT_PENALTY=1.08
