# 이 파일을 복사해서 .env 로 만들어 사용한다: cp .env.example .env
# .env 는 .gitignore 되어 커밋되지 않는다. 비밀 값은 절대 커밋하지 말 것.

# 로컬 LLM (llama.cpp gguf) - EXAONE-3.5-2.4B (한국어 특화)
LOCAL_LLM_MODEL_PATH=/home/chatbot/voicebot/models/EXAONE-3.5-2.4B-Instruct-Q4_K_M.gguf

# 원격 LLM (PC). 비워두면 항상 위의 로컬 gguf 만 쓴다.
# PC 가 켜져 있고 서버가 떠 있으면 그쪽에서 생성하고, 꺼져 있으면 자동으로
# 로컬로 떨어진다. 발화마다(캐시 10초) 확인하므로 파이를 재시작할 필요 없다.
#   ollama:           http://192.168.0.10:11434/v1   (PC에 OLLAMA_HOST=0.0.0.0 필요)
#   llama.cpp server: http://192.168.0.10:8080/v1
#   LM Studio:        http://192.168.0.10:1234/v1
REMOTE_LLM_URL=
# 비우면 서버가 가진 첫 모델을 쓴다. ollama 면 예: exaone3.5:7.8b
REMOTE_LLM_MODEL=
REMOTE_LLM_API_KEY=
REMOTE_LLM_PROBE_TIMEOUT=1.0
REMOTE_LLM_PROBE_TTL=10
REMOTE_LLM_TIMEOUT=30
REMOTE_MAX_TOKENS=256

# 로컬 STT (SenseVoiceSmall ONNX)
SENSEVOICE_DIR=/home/chatbot/voicebot/models/sensevoice_ko
STT_LANGUAGE=ko
# int8 양자화 모델(model_quant.onnx)을 쓰려면 true
SENSEVOICE_QUANTIZE=true

# 무료 웹 검색 (DuckDuckGo, API 키/비용 없음)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_RESULTS=4
WEB_SEARCH_REGION=kr-kr

# TTS (edge-tts)
EDGE_TTS_VOICE=ko-KR-SunHiNeural

# 호출 이름(웨이크워드)
BOT_NAME=제리
REQUIRE_WAKE_NAME=true

# 오디오 녹음
RECORD_SECONDS=5
# INPUT_DEVICE를 비워두면 시스템 기본 입력(ReSpeaker)을 사용한다.
INPUT_DEVICE=
SAMPLE_RATE=16000
CHANNELS=1

# 로컬 LLM 파라미터 (Pi 4B 4GB, 품질 우선)
N_CTX=2048
N_THREADS=4
N_THREADS_BATCH=4
N_BATCH=128
MAX_HISTORY_MESSAGES=6
MAX_TOKENS=160
TEMPERATURE=0.5
TOP_P=0.9
REPEAT_PENALTY=1.1

# 상시청취(ROS) VAD - 에너지 기반, 노이즈 환경 맞춰 조정
VAD_START_FACTOR=3.0
VAD_MARGIN=0.015
VAD_MIN_SPEECH_MS=300
VAD_HANG_MS=600
VAD_MAX_UTT_MS=12000
