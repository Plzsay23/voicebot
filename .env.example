# 이 파일을 복사해서 .env 로 만들어 사용한다: cp .env.example .env
# .env 는 .gitignore 되어 커밋되지 않는다. 비밀 값은 절대 커밋하지 말 것.

# 로컬 LLM (llama.cpp gguf) - EXAONE-3.5-2.4B (한국어 특화)
LOCAL_LLM_MODEL_PATH=/home/chatbot/voicebot/models/EXAONE-3.5-2.4B-Instruct-Q4_K_M.gguf

# 로컬 STT (SenseVoiceSmall ONNX)
SENSEVOICE_DIR=/home/chatbot/voicebot/models/sensevoice_ko
STT_LANGUAGE=ko
# int8 양자화 모델(model_quant.onnx)을 쓰려면 true
SENSEVOICE_QUANTIZE=true

# 무료 웹 검색 (DuckDuckGo, API 키/비용 없음)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_RESULTS=4
WEB_SEARCH_REGION=kr-kr

# TTS (edge-tts)
EDGE_TTS_VOICE=ko-KR-SunHiNeural

# 호출 이름(웨이크워드)
BOT_NAME=제리
REQUIRE_WAKE_NAME=true

# 오디오 녹음
RECORD_SECONDS=5
# INPUT_DEVICE를 비워두면 시스템 기본 입력(ReSpeaker)을 사용한다.
INPUT_DEVICE=
SAMPLE_RATE=16000
CHANNELS=1

# 로컬 LLM 파라미터 (Pi 4B 4GB, 품질 우선)
N_CTX=2048
N_THREADS=4
N_THREADS_BATCH=4
N_BATCH=128
MAX_HISTORY_MESSAGES=6
MAX_TOKENS=256
TEMPERATURE=0.5
TOP_P=0.9
REPEAT_PENALTY=1.1
